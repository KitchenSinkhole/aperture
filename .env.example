# Copy to .env and fill in.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/aperture

# Auth.js — generate with `openssl rand -base64 32`
AUTH_SECRET=

# EVE SSO OAuth2 app credentials — register at https://developers.eveonline.com/applications
# Set the app's callback URL to <your-origin>/api/auth/callback/eve
AUTH_EVE_CLIENT_ID=
AUTH_EVE_CLIENT_SECRET=

# EVE SSO base host. Default is Tranquility (live). For the SISI test server use
# https://sisilogin.testeveonline.com
AUTH_EVE_SSO_BASE=https://login.eveonline.com

# ESI base host. Default is the live API; the SISI test server is reached via the
# ESI_DATASOURCE constant (singularity), not a separate host.
ESI_BASE_URL=https://esi.evetech.net

# CCP requires every ESI client to identify itself. The version is read from
# package.json if this var is unset, so you only need to set it to customise
# the contact address.
# EVE_USER_AGENT=Aperture/1.0.0-alpha.1 (contact@example.com)

# Used to encrypt esi_access_token / esi_refresh_token at rest. Generate with `openssl rand -base64 32`
ESI_TOKEN_ENC_KEY=

# Setup wizard
# Required in production. Gates the /setup ops console. Pick a long random string;
# rotating it invalidates active unlock cookies.
SETUP_PASSWORD=

# Prometheus metrics endpoint (/api/metrics). Off by default. Set ENABLED=true and
# a token to opt in; scrape with `Authorization: Bearer <token>` (or ?token=).
# Generate the token with `openssl rand -hex 32`. Enabling with an empty token
# leaves the endpoint closed (every request 401s).
METRICS_ENABLED=false
METRICS_TOKEN=

# Instance alerting (Phase 6). Two Discord webhook URLs, both optional — the
# in-process alert loop no-ops unless at least one is set. STATUS_WEBHOOK_URL is
# the terse, user-facing public status channel; ALERT_WEBHOOK_URL is the verbose,
# PII-scrubbed operator channel. Create a webhook via Discord channel
# Settings → Integrations → Webhooks.
ALERT_WEBHOOK_URL=
STATUS_WEBHOOK_URL=

# Auth.js v5: pin the canonical origin so it doesn't have to derive it from
# request headers (which Next 16's custom server populates as x-forwarded-host +
# x-forwarded-port, and which earlier produced doubled-port redirects when the
# bind host disagreed with the browser host).
AUTH_URL=